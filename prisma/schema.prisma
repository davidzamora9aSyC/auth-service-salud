generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  PATIENT
  DOCTOR
  CLINIC
  EMPLOYER
  COLLABORATOR
  ADMIN
  MEMBER
}

enum ProductCode {
  MEUDOC_PRO
  PATIENT_PORTAL
  MEUDOC_ADMIN
  MEURED
  MEUDOC_EMPLOYER
}

enum ProductRole {
  DOCTOR
  RESEARCHER
  STUDENT
  MEDICAL_ENTITY
  ENTITY_ADMIN
  ADMIN
  EMPLOYER_ADMIN
  EMPLOYER_BILLING
}

enum ProductAccessStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum AccountStatus {
  ACTIVE
  LOCKED
}

enum TwoFactorMethod {
  TOTP
  WHATSAPP
}

enum TwoFactorChallengePurpose {
  LOGIN
  SETUP
  DISABLE
}

enum OnboardingStatus {
  PENDING
  COMPLETE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CollaboratorStatus {
  ACTIVE
  DISABLED
}

enum AccountDeletionChannel {
  EMAIL
  WHATSAPP
}

enum AccountVerificationChannel {
  EMAIL
  WHATSAPP
}

enum AccountDeletionAuditStatus {
  COMPLETED
  PARTIAL
  FAILED
}

enum LoginEventSource {
  PASSWORD
  TWO_FACTOR
  OAUTH_GOOGLE
  OAUTH_APPLE
}

enum ClinicAdminRole {
  OWNER
  ADMIN
}

enum ClinicDoctorMembershipStatus {
  ACTIVE
  REMOVED
}

model Account {
  id                     String                @id @default(uuid())
  email                  String                @unique
  phoneNumber            String?               @unique
  passwordHash           String
  salt                   String
  role                   AccountRole
  subjectId              String?
  doctorId               String?               @unique
  employerId             String?               @unique
  onboardingStatus       OnboardingStatus      @default(COMPLETE)
  status                 AccountStatus         @default(ACTIVE)
  twoFactorEnabled       Boolean               @default(false)
  twoFactorMethod        TwoFactorMethod?
  twoFactorSecret        String?
  pendingTwoFactorSecret String?
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  refreshTokens          RefreshToken[]
  twoFactorChallenges    TwoFactorChallenge[]
  passwordRecoveries     PasswordRecovery[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  loginHistory           LoginHistory[]
  accountDeletionChallenges AccountDeletionChallenge[]
  accountPhoneChanges    AccountPhoneChange[]
  accountDeletionAudits  AccountDeletionAudit[]
  accountIdentityReuseAudits AccountIdentityReuseAudit[]
  collaborator           Collaborator?
  clinicAdmins           ClinicAdmin[]
  createdClinics         Clinic[]               @relation("ClinicCreatedBy")
  createdClinicMemberships ClinicDoctorMembership[] @relation("ClinicMembershipCreatedBy")
  createdClinicDoctorInvites ClinicDoctorInvite[]   @relation("ClinicDoctorInviteCreatedBy")
  roleProfiles           AccountRoleProfile[]
  productAccesses        AccountProductAccess[]

  @@index([subjectId, role])
}

model AccountProductAccess {
  id        String              @id @default(uuid())
  accountId String
  product   ProductCode
  role      ProductRole
  subjectId String?
  status    ProductAccessStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, product, role])
  @@index([accountId])
  @@index([product, role])
  @@index([subjectId])
}

model AccountRoleProfile {
  id               String           @id @default(uuid())
  accountId        String
  role             AccountRole
  subjectId        String?
  doctorId         String?          @unique
  onboardingStatus OnboardingStatus @default(COMPLETE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([accountId])
}

model Clinic {
  id                 String   @id @default(uuid())
  name               String
  legalName          String?
  taxId              String?
  description        String?
  website            String?
  phoneNumber        String?
  email              String?
  profileImageId     String?
  coverImageId       String?
  createdByAccountId String
  createdBy          Account  @relation("ClinicCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  admins             ClinicAdmin[]
  doctorMemberships  ClinicDoctorMembership[]
  doctorInvites      ClinicDoctorInvite[]
  locations          ClinicLocation[]

  @@index([name])
  @@index([createdByAccountId])
}

model ClinicLocation {
  id                 String   @id @default(uuid())
  clinicId           String
  label              String?
  city               String
  address            String
  postalCode         String?
  additionalInfo     String?
  placeId            String?
  formattedAddress   String?
  department         String?
  countryCode        String?
  lat                Float?
  lng                Float?
  isPrimary          Boolean  @default(false)
  active             Boolean  @default(true)
  createdByAccountId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  agendaAssignments  ClinicAgendaAssignment[]

  @@index([clinicId, active])
  @@index([clinicId, isPrimary])
  @@index([createdByAccountId])
}

model ClinicAgendaAssignment {
  clinicLocationId   String
  agendaId           String
  doctorId           String
  active             Boolean  @default(true)
  createdByAccountId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinicLocation     ClinicLocation @relation(fields: [clinicLocationId], references: [id], onDelete: Cascade)

  @@id([clinicLocationId, agendaId])
  @@unique([agendaId])
  @@index([doctorId, active])
  @@index([createdByAccountId])
}

model ClinicAdmin {
  clinicId   String
  accountId  String
  role       ClinicAdminRole @default(ADMIN)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  clinic     Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([clinicId, accountId])
  @@index([accountId])
  @@index([active])
}

model ClinicDoctorMembership {
  clinicId            String
  doctorId            String
  status              ClinicDoctorMembershipStatus @default(ACTIVE)
  createdByAccountId  String
  createdBy           Account                      @relation("ClinicMembershipCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  clinic              Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([clinicId, doctorId])
  @@index([doctorId])
  @@index([status])
  @@index([createdByAccountId])
}

model ClinicDoctorInvite {
  id                String      @id @default(uuid())
  clinicId          String
  doctorId          String
  email             String
  tokenHash         String      @unique
  status            InviteStatus @default(PENDING)
  expiresAt         DateTime
  inviterAccountId  String
  inviterAccount    Account     @relation("ClinicDoctorInviteCreatedBy", fields: [inviterAccountId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  clinic            Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([doctorId, status])
  @@index([email])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collaboratorPermissions CollaboratorPermission[]
  invitePermissions       CollaboratorInvitePermission[]
}

model Collaborator {
  id        String             @id @default(uuid())
  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String             @unique
  doctorId  String
  firstName String
  lastName  String
  status    CollaboratorStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  permissions CollaboratorPermission[]
  agendas     CollaboratorAgenda[]

  @@index([doctorId])
}

model CollaboratorPermission {
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  collaboratorId String
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId   String
  createdAt      DateTime     @default(now())

  @@id([collaboratorId, permissionId])
  @@index([permissionId])
}

model CollaboratorAgenda {
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  collaboratorId String
  agendaId       String
  createdAt      DateTime     @default(now())

  @@id([collaboratorId, agendaId])
  @@index([agendaId])
}

model CollaboratorInvite {
  id               String       @id @default(uuid())
  doctorId         String
  email            String
  phoneNumber      String?
  tokenHash        String       @unique
  expiresAt        DateTime
  status           InviteStatus @default(PENDING)
  inviterAccountId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  permissions CollaboratorInvitePermission[]
  agendas     CollaboratorInviteAgenda[]

  @@index([doctorId])
  @@index([email])
}

model CollaboratorInvitePermission {
  invite       CollaboratorInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId     String
  permission   Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime           @default(now())

  @@id([inviteId, permissionId])
  @@index([permissionId])
}

model CollaboratorInviteAgenda {
  invite    CollaboratorInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId  String
  agendaId  String
  createdAt DateTime           @default(now())

  @@id([inviteId, agendaId])
  @@index([agendaId])
}

model DoctorOnboardingInvite {
  id                String       @id @default(uuid())
  doctorId          String       @unique
  authUserId        String?
  email             String
  phoneNumber       String?
  firstName         String?
  lastName          String?
  tokenHash         String       @unique
  status            InviteStatus @default(PENDING)
  preferredPlanCode String?
  expiresAt         DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([email])
  @@index([doctorId, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  sessionRole AccountRole?
  sessionSubjectId String?
  activeProduct ProductCode?
  activeProductRole ProductRole?
  productSubjectId String?
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TwoFactorChallenge {
  id          String                   @id
  account     Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  sessionRole AccountRole?
  method      TwoFactorMethod
  purpose     TwoFactorChallengePurpose @default(LOGIN)
  codeHash    String?
  destination String?
  expiresAt   DateTime
  resolved    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
}

model PasswordRecovery {
  id              String   @id @default(uuid())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String
  codeHash        String
  resetTokenHash  String?
  magicTokenHash  String?
  expiresAt       DateTime
  resetExpiresAt  DateTime?
  magicExpiresAt  DateTime?
  verifiedAt      DateTime?
  consumedAt      DateTime?
  magicConsumedAt DateTime?
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([accountId])
  @@index([magicTokenHash])
}

model OAuthClient {
  id                String   @id @default(uuid())
  clientId          String   @unique
  name              String
  secretHash        String?
  redirectUris      String[]
  allowedScopes     String[]
  allowedGrantTypes String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  authorizationCodes OAuthAuthorizationCode[]
}

model OAuthAuthorizationCode {
  id                  String   @id @default(uuid())
  codeHash            String   @unique
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  clientId            String
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId           String
  redirectUri         String
  scope               String
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime @default(now())

  @@index([clientId])
  @@index([accountId])
}

model LoginHistory {
  id         String           @id @default(uuid())
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  role       AccountRole
  source     LoginEventSource
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([role, createdAt])
}

model AccountDeletionChallenge {
  id           String                 @id @default(uuid())
  account      Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String
  channel      AccountDeletionChannel
  destination  String
  codeHash     String
  expiresAt    DateTime
  attempts     Int                    @default(0)
  maxAttempts  Int                    @default(5)
  verifiedAt   DateTime?
  consumedAt   DateTime?
  createdAt    DateTime               @default(now())

  @@index([accountId, createdAt])
  @@index([expiresAt])
}

model AccountPhoneChange {
  id            String                    @id @default(uuid())
  account       Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  channel       AccountVerificationChannel
  destination   String
  codeHash      String
  tokenHash     String?
  expiresAt     DateTime
  tokenExpiresAt DateTime?
  attempts      Int                       @default(0)
  maxAttempts   Int                       @default(5)
  verifiedAt    DateTime?
  consumedAt    DateTime?
  createdAt     DateTime                  @default(now())

  @@index([accountId, createdAt])
  @@index([expiresAt])
}

model AccountDeletionAudit {
  id                   String                    @id @default(uuid())
  account              Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId            String
  role                 AccountRole
  channel              AccountDeletionChannel
  status               AccountDeletionAuditStatus
  requestIp            String?
  requestUserAgent     String?
  requestedAt          DateTime                  @default(now())
  deletedAt            DateTime?
  detailsJson          Json?
  error                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

model AccountIdentityReuseAudit {
  id                     String   @id @default(dbgenerated("gen_random_uuid()"))
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId              String
  previousAccountId      String?
  previousDeletionAuditId String?
  matchedBy              String
  matchedValue           String?
  createdAt              DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([previousAccountId, createdAt])
  @@index([matchedBy, createdAt])
}
